{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📦 deps",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-e", ".[dev]"],
      "problemMatcher": []
    },
    {
      "label": "✅ check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/verify.py"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "🎨 format",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/verify.py", "--fix"],
      "problemMatcher": []
    },
    {
      "label": "🦀 rust",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["build_node.py", "--check"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "🏗️ wheel",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["build_node.py"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "⚡ wheel dev",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["build_node.py", "--dev"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "🧹 clean",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/clean_generated.py"],
      "problemMatcher": []
    }
  ]
}
